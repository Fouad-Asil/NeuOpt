  "rules": [
    {
      "file": "paper.pdf",
      "prompt": "This file contains the theoretical information about this research. The paper titled 'Learning to Search Feasible and Infeasible Regions of Routing Problems with Flexible Neural k-Opt' was published in NeurIPS 2023 (vol. 36). It introduces NeuOpt, a learning-to-search (L2S) solver for Vehicle Routing Problems (VRPs) that learns to perform flexible k-opt exchanges using novel techniques including: 1) Tailored Action Factorization (S-move, I-move, E-move), 2) Customized Recurrent Dual-Stream (RDS) decoder, 3) Guided Infeasible Region Exploration (GIRE), and 4) Dynamic Data Augmentation (D2A).",
      "contextLevel": "full"
    },
